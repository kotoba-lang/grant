;; The grant plane: who may do what, decided as pure data.
;;
;; Deliberately narrower than the repository it came out of. There is no Wasm
;; runtime here and no engine dependency of any kind -- `aiueos.execute`'s
;; Chicory dependency stayed with the machine, because deciding whether a
;; component may run is not the same act as running it (root ADR-2608219500).
;;
;; `security` supplies redaction / ABAC / crypto-policy / hardware predicates;
;; `abi` supplies the shared component contract. Nothing else is needed, and
;; adding an engine here would put the decision plane behind one.
{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "49fc4ce359752e9fe6e547e9071b5b9b40da937a"}
        io.github.kotoba-lang/abi {:git/url "https://github.com/kotoba-lang/abi.git"
                                   :git/sha "32ee84b2efc92478c846629c8d8319280eed506c"}
        io.github.kotoba-lang/authority {:git/url "https://github.com/kotoba-lang/authority.git"
                                         :git/sha "232eef9b7969aa5990f9b5e48b1184f078500781"}
        io.github.kotoba-lang/identity {:git/url "https://github.com/kotoba-lang/identity.git"
                                        :git/sha "6e4a07eaf44e3dbebfb4b340fd4f11448490f71f"}
        ;; `kotobase.biscuit-grant` reads a Biscuit's signature chain through
        ;; biscuit.wire / biscuit.authority. authority above is its other half.
        io.github.kotoba-lang/org-biscuitsec
        {:git/url "https://github.com/kotoba-lang/org-biscuitsec.git"
         :git/sha "d4e35e6792e9d23bdd25f48006b2886424fd48b1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
